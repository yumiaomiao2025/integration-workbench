{
  "name": "integration-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "check": "tsc --noEmit && node --check web/app.js && node --check web/settings.js",
    "test": "node --test \"test/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "devtools-protocol": "^0.0.1751165",
    "typescript": "^7.0.2",
    "ws": "^8.23.0"
  }
}
