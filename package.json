{
  "name": "integration-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start": "pnpm build && node --env-file-if-exists=.env src/server.ts",
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js",
    "build": "vite build",
    "check": "tsc --noEmit && tsc -p web/tsconfig.json",
    "test": "node --test \"test/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "devtools-protocol": "^0.0.1751165",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "ws": "^8.23.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
